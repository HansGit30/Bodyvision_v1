# Copia a .env y ajusta. Todas son opcionales en desarrollo.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./bodyvision.db          # o postgresql+psycopg://user:pass@host:5432/db (postgres:// también se acepta)
SECRET_KEY=cambia-esta-clave-larga-y-aleatoria   # obligatorio en producción
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
SIGNED_URL_TTL_SECONDS=300
MEDIA_RETENTION_DAYS=365
STATIC_DIR=../frontend/dist
ADMIN_EMAIL=admin@bodyvision.ai
ADMIN_PASSWORD=BodyVision2026!
SEED_DEMO=true
# Frontend (Vite): URL de la API si se sirve en otro dominio
VITE_API_URL=
